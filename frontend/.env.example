# Copia este archivo como ".env" (en esta misma carpeta) y reinicia "npm run dev".
# Las variables VITE_* quedan visibles en el navegador: aquí NUNCA van claves secretas.

# ------------------------------------------------------------------
# MODO 1: DEMOSTRACIÓN (sin backend ni Firebase). Ideal para empezar.
# Cuentas: director@demo.com, tutor@demo.com, asesor@demo.com,
#          estudiante@demo.com, estudiante5@demo.com  (clave: demo1234)
# ------------------------------------------------------------------
VITE_USE_MOCK=true

# ------------------------------------------------------------------
# MODO 2: CON BACKEND REAL. Pon VITE_USE_MOCK=false y completa lo siguiente.
# ------------------------------------------------------------------
# Dirección del backend. Déjala vacía en desarrollo para usar el proxy de Vite
# hacia VITE_PROXY_TARGET. En producción, la URL pública de la API.
VITE_API_URL=
# Prefijo de las rutas (por defecto "api" => /api/users, /api/logbooks...)
VITE_API_PREFIX=api
# Backend al que apunta el proxy de desarrollo
VITE_PROXY_TARGET=http://localhost:3000
# Actualizaciones en vivo (GET /api/events). Solo si el backend las ofrece.
VITE_REALTIME=false

# Firebase (Project Settings > General > Tus apps > Configuración del SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
